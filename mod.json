{
	"geode": "5.10.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "minimum.optimization",
	"name": "Minimum",
	"version": "v2.0.5",
	"developer": "ziyyhhk",
	"description": "Live optimization mod. Tab-out volume, optional draw divide, particle and batch opts. Draw divide is OFF by default.",
	"early-load": true,
	"tags": ["optimization", "performance", "utility"],
	"links": {
		"source": "https://github.com/ziyyhhk/Minimum"
	},
	"settings": {
		"title-main": {
			"type": "title",
			"name": "Main"
		},
		"mod-enabled": {
			"name": "Enable Minimum",
			"description": "Master switch. Toggle in a level with no restart.",
			"type": "bool",
			"default": true
		},
		"performance-mode": {
			"name": "Performance Mode",
			"description": "Forces particle and batch opts only. Does NOT force Draw Divide.",
			"type": "bool",
			"default": true
		},
		"title-render": {
			"type": "title",
			"name": "Render (optional)"
		},
		"draw-divide": {
			"name": "Draw Divide",
			"description": "OFF by default. Renders at Visual FPS while logic stays full speed. In-game FPS counter shows logic rate not visual FPS. Only turn on if GPU bound.",
			"type": "bool",
			"default": false
		},
		"visual-fps": {
			"name": "Visual FPS",
			"description": "Only used when Draw Divide is ON. Set to monitor Hz.",
			"type": "float",
			"min": 30,
			"max": 360,
			"default": 60
		},
		"title-audio": {
			"type": "title",
			"name": "Audio"
		},
		"background-volume": {
			"name": "Lower Volume When Tabbed Out",
			"description": "Drops music and SFX on alt-tab so YouTube is clearer.",
			"type": "bool",
			"default": true
		},
		"background-volume-scale": {
			"name": "Background Volume Scale",
			"description": "0 mute, 0.15 quiet, 1 full.",
			"type": "float",
			"min": 0,
			"max": 1,
			"default": 0.1
		},
		"title-level": {
			"type": "title",
			"name": "Level enter and exit"
		},
		"fast-level-exit": {
			"name": "Fast Level Exit",
			"description": "Stops particles on quit to cut freezes.",
			"type": "bool",
			"default": true
		},
		"fast-level-enter": {
			"name": "Fast Level Enter",
			"description": "Warms thread pool early.",
			"type": "bool",
			"default": true
		},
		"title-batch": {
			"type": "title",
			"name": "Batch rendering"
		},
		"skip-empty-batch": {
			"name": "Skip Empty Batches",
			"description": "Skip draw for empty sprite batches.",
			"type": "bool",
			"default": true
		},
		"parallel-batch": {
			"name": "Parallel Batch Transforms",
			"description": "Thread pool transforms for large batches.",
			"type": "bool",
			"default": true
		},
		"parallel-threshold": {
			"name": "Parallel Threshold",
			"description": "Child count before parallel runs.",
			"type": "int",
			"min": 32,
			"max": 512,
			"default": 48
		},
		"fast-batch-sort": {
			"name": "Fast Batch Sort",
			"description": "Faster sort for large batches.",
			"type": "bool",
			"default": true
		},
		"title-particles": {
			"type": "title",
			"name": "Particles"
		},
		"cull-particles": {
			"name": "Cull Offscreen Particles",
			"description": "Skip update far off screen.",
			"type": "bool",
			"default": true
		},
		"cull-margin": {
			"name": "Cull Margin",
			"description": "Lower = more aggressive.",
			"type": "float",
			"min": 20,
			"max": 400,
			"default": 50
		},
		"limit-particles": {
			"name": "Limit Particle Count",
			"description": "Hard cap per system.",
			"type": "bool",
			"default": true
		},
		"particle-cap": {
			"name": "Particle Cap",
			"description": "Max particles per system.",
			"type": "int",
			"min": 4,
			"max": 200,
			"default": 16
		},
		"reduce-emission": {
			"name": "Reduce Particle Emission",
			"description": "Lower spawn rate.",
			"type": "bool",
			"default": true
		},
		"emission-scale": {
			"name": "Emission Scale",
			"description": "Spawn rate multiplier.",
			"type": "float",
			"min": 0.05,
			"max": 1.0,
			"default": 0.12
		},
		"skip-particle-draw": {
			"name": "Skip Offscreen Particle Draw",
			"description": "Do not draw offscreen particles.",
			"type": "bool",
			"default": true
		},
		"smooth-particles": {
			"name": "Smooth Particles",
			"description": "Update offscreen systems every other frame.",
			"type": "bool",
			"default": true
		},
		"title-streaks": {
			"type": "title",
			"name": "Trails"
		},
		"cull-streaks": {
			"name": "Cull Offscreen Streaks",
			"description": "Skip streak update and draw off screen.",
			"type": "bool",
			"default": true
		},
		"title-qol": {
			"type": "title",
			"name": "Quality of life"
		},
		"fast-alt-tab": {
			"name": "Fast Alt Tab",
			"description": "Skip save when unfocusing.",
			"type": "bool",
			"default": true
		},
		"force-rgba8888": {
			"name": "Force RGBA8888",
			"description": "Sharper textures. Windows only.",
			"type": "bool",
			"default": false
		},
		"anti-aliasing": {
			"name": "Anti Aliasing",
			"description": "MSAA 0 off to 4. Keep 0 for max FPS.",
			"type": "int",
			"min": 0,
			"max": 4,
			"default": 0
		}
	}
}
